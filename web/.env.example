# Copy to web/.env.local and fill in what you need. With nothing set, the
# site shows how to connect a database. `npm run demo` (from the project
# folder) needs no file at all.

# --- Where the data lives -----------------------------------------------------

# local: a database inside the dev server (PGlite), no Supabase or Docker.
# Always a demo: practice tournaments, fast-forward, test checkout, text log.
NEXT_PUBLIC_DATA_MODE=local

# Supabase instead: remove NEXT_PUBLIC_DATA_MODE and set these
# (Supabase → Project Settings → API Keys).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: lets the server confirm payments and send texts.
# SUPABASE_SECRET_KEY=
# Protects /api/texts/send, which a scheduler calls every minute.
# CRON_SECRET=

# 1 = hosted demo site: no sign-in, practice tournaments, test checkout and
# text log whatever keys are set (docs/demo-site.md).
# NEXT_PUBLIC_DEMO_MODE=1
# The one Supabase account every demo visitor shares (Authentication → Users →
# Add user, auto-confirmed). The password reaches the browser: demo use only.
# NEXT_PUBLIC_DEMO_GUEST_EMAIL=guest@example.com
# NEXT_PUBLIC_DEMO_GUEST_PASSWORD=

# Base for the score links in texts (default http://localhost:3000).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments (none = built-in test checkout) ---------------------------------

# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Texts (none = recorded on the Texts page, not sent; docs/twilio.md) ------

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# or instead of a number:
# TWILIO_MESSAGING_SERVICE_SID=
# log = record texts even when Twilio is set up.
# SMS_MODE=log

# --- Emails (none = logged, not sent) -----------------------------------------

# RESEND_API_KEY=
# EMAIL_FROM=Courtside <tournaments@example.com>
